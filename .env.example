# Token del bot de Telegram (lo consigues hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# API key de Google Gemini — gratis en https://aistudio.google.com/apikey (sin tarjeta)
GEMINI_API_KEY=

# Conexión a PostgreSQL (con el docker-compose de abajo, este valor ya funciona tal cual)
DATABASE_URL=postgresql://docubot:docubot@localhost:5432/docubot
